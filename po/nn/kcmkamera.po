#: kamera.cpp:71
#, kde-format
msgid "Unable to initialize the gPhoto2 libraries."
msgstr "Kan ikkje gjera klar gPhoto2-biblioteka."

#: kamera.cpp:108
#, kde-format
msgid "Add"
msgstr "Legg til"

#: kamera.cpp:110
#, kde-format
msgid "Click this button to add a new camera."
msgstr "Bruk denne knappen for å leggja til eit nytt kamera."

#: kamera.cpp:116
#, kde-format
msgid "Test"
msgstr "Test"

#: kamera.cpp:118
#, kde-format
msgid "Click this button to test the connection to the selected camera."
msgstr "Bruk denne knappen for testa tilkoplinga til det valde kameraet."

#: kamera.cpp:123
#, kde-format
msgid "Remove"
msgstr "Fjern"

#: kamera.cpp:125
#, kde-format
msgid "Click this button to remove the selected camera from the list."
msgstr "Bruk denne knappen for å fjerna det valde kameraet frå lista."

#: kamera.cpp:130
#, kde-format
msgid "Configure..."
msgstr "Oppsett …"

#: kamera.cpp:133
#, kde-format
msgid ""
"Click this button to change the configuration of the selected camera."
"<br><br>The availability of this feature and the contents of the "
"Configuration dialog depend on the camera model."
msgstr ""
"Bruk denne knappen for å endra oppsettet av det valte kameraet.<br/><br/"
">Denne funksjonen og innhaldet i oppsettvindauget er avhengige av "
"kameramodellen."

#: kamera.cpp:139
#, kde-format
msgid "Information"
msgstr "Informasjon"

#: kamera.cpp:142
#, kde-format
msgid ""
"Click this button to view a summary of the current status of the selected "
"camera.<br><br>The availability of this feature and the contents of the "
"Information dialog depend on the camera model."
msgstr ""
"Bruk denne knappen for å visa eit samandrag av tilstanden til det valde "
"kameraet.<br/><br/>Denne funksjonen og innhaldet i oppsettvindauget er "
"avhengige av kameramodellen."

#: kamera.cpp:149
#, kde-format
msgid "Cancel"
msgstr "Avbryt"

#: kamera.cpp:151
#, kde-format
msgid "Click this button to cancel the current camera operation."
msgstr "Bruk denne knappen for å avbryta kamerahandlinga."

#: kamera.cpp:355
#, kde-format
msgid "Camera test was successful."
msgstr "Kameratesten var vellukka."

#: kameraconfigdialog.cpp:226
#, kde-format
msgid "Button (not supported by KControl)"
msgstr "Knapp (ikkje støtta av KControl)"

#: kameraconfigdialog.cpp:233
#, kde-format
msgid "Date (not supported by KControl)"
msgstr "Dato (ikkje støtta av KControl)"

#: kameradevice.cpp:82
#, kde-format
msgid "Could not allocate memory for the abilities list."
msgstr "Klarte ikkje gje minne til funksjonslista."

#: kameradevice.cpp:86
#, kde-format
msgid "Could not load ability list."
msgstr "Klarte ikkje lasta funksjonslista."

#: kameradevice.cpp:92 kameradevice.cpp:542 kameradevice.cpp:560
#, kde-format
msgid ""
"Description of abilities for camera %1 is not available. Configuration "
"options may be incorrect."
msgstr ""
"Inga funksjonsskildring for kameraet %1 er tilgjengeleg. Innstillingane i "
"oppsettet kan vera galne."

#: kameradevice.cpp:117
#, kde-format
msgid "Could not access driver. Check your gPhoto2 installation."
msgstr "Fekk ikkje tilgang til drivar. Kontroller gPhoto2-installasjonen."

#: kameradevice.cpp:136
#, kde-format
msgid ""
"Unable to initialize camera. Check your port settings and camera "
"connectivity and try again."
msgstr ""
"Kan ikkje gjera klart kameraet. Kontroller portinnstillingane og "
"kameratilkoplinga og prøv igjen."

#: kameradevice.cpp:175
#, kde-format
msgid "No camera summary information is available.\n"
msgstr "Samandragsinformasjon om kameraet er ikkje tilgjengeleg.\n"

#: kameradevice.cpp:190 kameradevice.cpp:200
#, kde-format
msgid "Camera configuration failed."
msgstr "Kameraoppsettet va mislukka."

#: kameradevice.cpp:242 kameradevice.cpp:368
#, kde-format
msgid "Serial"
msgstr "Serie"

#: kameradevice.cpp:244 kameradevice.cpp:374
#, kde-format
msgid "USB"
msgstr "USB"

#: kameradevice.cpp:245
#, kde-format
msgid "Unknown port"
msgstr "Ukjend port"

#: kameradevice.cpp:310
#, kde-format
msgid "Select Camera Device"
msgstr "Vel kameraeining"

#: kameradevice.cpp:328
#, kde-format
msgctxt "@title:column"
msgid "Supported Cameras"
msgstr "Støtta kameramodellar"

#: kameradevice.cpp:338
#, kde-format
msgid "Filter by name…"
msgstr "Filtrer på namn …"

#: kameradevice.cpp:362 kameradevice.cpp:389
#, kde-format
msgid "Port"
msgstr "Port"

#: kameradevice.cpp:371
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's serial ports (known as COM ports in Microsoft Windows.)"
msgstr ""
"Viss denne funksjonen er vald, må kameraet koplast til ein av serieportane "
"på datamaskina («COM-portar» i Microsoft Windows)."

#: kameradevice.cpp:377
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's USB ports, or to a USB hub."
msgstr ""
"Viss denne funksjonen er vald, må kameraet koplast til ein av USB-portane på "
"maskina, eller i eit USB-nav."

#: kameradevice.cpp:380
#, kde-format
msgid "Port Settings"
msgstr "Portinnstillingar"

#: kameradevice.cpp:398
#, kde-format
msgid "No port type selected."
msgstr "Ingen porttype er vald."

#: kameradevice.cpp:405
#, kde-format
msgid "Port:"
msgstr "Port:"

#: kameradevice.cpp:409
#, kde-format
msgid "Specify here the serial port to which you connect the camera."
msgstr "Her vel du kva for ein serieport kameraet er kopla til."

#: kameradevice.cpp:416
#, kde-format
msgid "No further configuration is required for USB cameras."
msgstr "Treng ingen fleire innstillingar for USB-kamera."
