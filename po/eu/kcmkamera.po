#: kamera.cpp:71
#, kde-format
msgid "Unable to initialize the gPhoto2 libraries."
msgstr "Ezin dira gPhoto2 liburutegiak hasieratu."

#: kamera.cpp:108
#, kde-format
msgid "Add"
msgstr "Gehitu"

#: kamera.cpp:110
#, kde-format
msgid "Click this button to add a new camera."
msgstr "Klik egin botoi honetan kamera berri bat gehitzeko."

#: kamera.cpp:116
#, kde-format
msgid "Test"
msgstr "Probatu"

#: kamera.cpp:118
#, kde-format
msgid "Click this button to test the connection to the selected camera."
msgstr "Klik egin botoi honetan hautatutako kamerarekin konexioa probatzeko."

#: kamera.cpp:123
#, kde-format
msgid "Remove"
msgstr "Kendu"

#: kamera.cpp:125
#, kde-format
msgid "Click this button to remove the selected camera from the list."
msgstr "Klik egin botoi honetan hautatutako kamera zerrendatik kentzeko."

#: kamera.cpp:130
#, kde-format
msgid "Configure..."
msgstr "Konfiguratu..."

#: kamera.cpp:133
#, kde-format
msgid ""
"Click this button to change the configuration of the selected camera."
"<br><br>The availability of this feature and the contents of the "
"Configuration dialog depend on the camera model."
msgstr ""
"Klik egin botoi honetan hautatutako kameraren konfigurazioa aldatzeko. <br> "
"<br>Aukera hau eta haren konfigurazioa kamera modeloaren araberakoa da."

#: kamera.cpp:139
#, kde-format
msgid "Information"
msgstr "Informazioa"

#: kamera.cpp:142
#, kde-format
msgid ""
"Click this button to view a summary of the current status of the selected "
"camera.<br><br>The availability of this feature and the contents of the "
"Information dialog depend on the camera model."
msgstr ""
"Klik egin botoi honetan hautatutako kameraren uneko egoeraren laburpena "
"ikusteko. <br> <br>Aukera hau eta elkarrizketa-koadroaren edukia kamera "
"modeloaren araberakoa da."

#: kamera.cpp:149
#, kde-format
msgid "Cancel"
msgstr "Utzi"

#: kamera.cpp:151
#, kde-format
msgid "Click this button to cancel the current camera operation."
msgstr ""
"Klik egin botoi honetan uneko kameraren eragiketa bertan behera uzteko."

#: kamera.cpp:355
#, kde-format
msgid "Camera test was successful."
msgstr "Karama ongi probatu da."

#: kameraconfigdialog.cpp:226
#, kde-format
msgid "Button (not supported by KControl)"
msgstr "Botoia (KControlek ez du hau onartzen)"

#: kameraconfigdialog.cpp:233
#, kde-format
msgid "Date (not supported by KControl)"
msgstr "Data (KControlek ez du hau onartzen)"

#: kameradevice.cpp:82
#, kde-format
msgid "Could not allocate memory for the abilities list."
msgstr "Ezin izan da memoria alokatu ahalmenen zerrendarako."

#: kameradevice.cpp:86
#, kde-format
msgid "Could not load ability list."
msgstr "Ezin izan da ahalmenen zerrenda kargatu."

#: kameradevice.cpp:92 kameradevice.cpp:542 kameradevice.cpp:560
#, kde-format
msgid ""
"Description of abilities for camera %1 is not available. Configuration "
"options may be incorrect."
msgstr ""
"%1 kameraren ahalmenen azalpena ez dago eskuragarri. Konfigurazioko aukerak "
"oker egon daitezke."

#: kameradevice.cpp:117
#, kde-format
msgid "Could not access driver. Check your gPhoto2 installation."
msgstr ""
"Ezin izan da kontrolatzailea atzitu. Egiaztatu gPhoto2-ren instalazioa."

#: kameradevice.cpp:136
#, kde-format
msgid ""
"Unable to initialize camera. Check your port settings and camera "
"connectivity and try again."
msgstr ""
"Ezin da kamera hasieratu. Egiaztatu atakaren ezarpenak eta kameraren "
"konektibitatea eta saiatu berriz."

#: kameradevice.cpp:175
#, kde-format
msgid "No camera summary information is available.\n"
msgstr "Kameraren laburpeneko informazioa ez dago eskuragarri.\n"

#: kameradevice.cpp:190 kameradevice.cpp:200
#, kde-format
msgid "Camera configuration failed."
msgstr "Kamararen konfigurazioak huts egin du."

#: kameradevice.cpp:242 kameradevice.cpp:368
#, kde-format
msgid "Serial"
msgstr "Seriekoa"

#: kameradevice.cpp:244 kameradevice.cpp:374
#, kde-format
msgid "USB"
msgstr "USB"

#: kameradevice.cpp:245
#, kde-format
msgid "Unknown port"
msgstr "Ataka ezezaguna"

#: kameradevice.cpp:310
#, kde-format
msgid "Select Camera Device"
msgstr "Hautatu kameraren gailua"

#: kameradevice.cpp:328
#, kde-format
msgctxt "@title:column"
msgid "Supported Cameras"
msgstr "Onartutako kamerak"

#: kameradevice.cpp:338
#, kde-format
msgid "Filter by name…"
msgstr "Izenaren arabera iragazi…"

#: kameradevice.cpp:362 kameradevice.cpp:389
#, kde-format
msgid "Port"
msgstr "Ataka"

#: kameradevice.cpp:371
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's serial ports (known as COM ports in Microsoft Windows.)"
msgstr ""
"Aukera hau hautatuta badago, kamera ordenagailuko serieko ataka batera "
"konektatua egon behar da (COM gisa ezagunak Microsoft Windows-en)."

#: kameradevice.cpp:377
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's USB ports, or to a USB hub."
msgstr ""
"Aukera hau hautatuta badago, kamera ordenagailuko USB ataketako batera "
"konektatuta egon behar da edo USB hub batean."

#: kameradevice.cpp:380
#, kde-format
msgid "Port Settings"
msgstr "Atakaren ezarpenak"

#: kameradevice.cpp:398
#, kde-format
msgid "No port type selected."
msgstr "Ez da ataka motarik hautatu."

#: kameradevice.cpp:405
#, kde-format
msgid "Port:"
msgstr "Ataka:"

#: kameradevice.cpp:409
#, kde-format
msgid "Specify here the serial port to which you connect the camera."
msgstr "Zehaztu hemen kamera zein serieko atakara konektatu duzun."

#: kameradevice.cpp:416
#, kde-format
msgid "No further configuration is required for USB cameras."
msgstr "Ez da konfigurazio gehiagorik behar USB kamararako."

#~ msgid ""
#~ "<h1>Digital Camera</h1>\n"
#~ "This module allows you to configure support for your digital camera.\n"
#~ "You need to select the camera's model and the port it is connected\n"
#~ "to on your computer (e.g. USB, Serial, Firewire). If your camera does "
#~ "not\n"
#~ "appear on the list of <i>Supported Cameras</i>, go to the\n"
#~ "<a href=\"http://www.gphoto.org\">GPhoto web site</a> for a possible "
#~ "update.<br><br>\n"
#~ "To view and download images from the digital camera, go to the address\n"
#~ "<a href=\"camera:/\">camera:/</a> in Konqueror and other KDE applications."
#~ msgstr ""
#~ "<h1>Kamara digitala</h1>\n"
#~ "Modulu honek zure kamera digitalaren euskarria konfiguratzen uzten dizu.\n"
#~ "Kamararen modeloa eta konektatzeko duzun ataka mota (adib. USB, seriekoa, "
#~ "Firewire) hautatu behar duzu.\n"
#~ "Zure kamera <i>Onartutako kamerak</i> zerrendan ez badago, joan\n"
#~ "<a href=\"http://www.gphoto.org\">GPhoto web lekura</a> ea eguneraketarik "
#~ "dagoen.<br><br>\n"
#~ "Kamara digitaleko irudiak ikusi eta jeisteko joan\n"
#~ "<a href=\"camera:/\">camera:/</a> helbidera Konqueror-en eta beste KDE "
#~ "aplikazioetan."
